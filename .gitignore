# Analysis-ready datasets ARE committed (real PVGIS + Carbon API pulls + the
# UoW Bikes demand series) so the repo ships with data and runs offline.
# (Refresh with scripts/fetch_real_data.py; regenerate fallbacks with prepare_data.py.)

# Large / regenerable outputs we don't track (interactive HTML, raw MC samples).
outputs/*.html
outputs/monte_carlo_*.csv
outputs/_slides/

# We DO commit the showcase PNGs and small result artifacts so judges can browse
# the repo on GitHub without running anything:
#   outputs/*.png, results.json, executive_summary.txt, scenario_summary.csv,
#   pareto_frontier.csv, tornado_sensitivity.csv  (all kept by default)

.claude/
